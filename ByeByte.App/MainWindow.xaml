<!-- TO DO: Add dropdown menu to title in title bar that has an about section -->

<ui:FluentWindow x:Class="ByeByte.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 FontFamily="Segoe UI"
                 FontSize="14"
                 Title="ByeByte"
                 Width="1200"
                 Height="800"
                 MinWidth="850"
                 MinHeight="550"
                 WindowStartupLocation="CenterScreen"
                 Background="Transparent"
                 WindowBackdropType="Acrylic"
                 ExtendsContentIntoTitleBar="True"
                 StateChanged="Window_OnStateChanged"
                 PreviewMouseLeftButtonDown="Window_OnPreviewMouseLeftButtonDown"
                 Foreground="#FFF2F2F2">
    <Window.Resources>
        <Style x:Key="ExplorerSortHeader" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFF2F2F2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExplorerColumnDivider" TargetType="GridSplitter">
            <Setter Property="Width" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="ResizeDirection" Value="Columns"/>
            <Setter Property="ResizeBehavior" Value="CurrentAndNext"/>
            <Setter Property="ShowsPreview" Value="False"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Panel.ZIndex" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="{TemplateBinding Background}">
                            <Border Width="1"
                                    HorizontalAlignment="Right"
                                    Background="#A0454545"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="#B3E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Border Background="#80000000">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Background="#FF111111"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="ByeByte" 
                               Margin="16,0"
                               VerticalAlignment="Center"/>
                    
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Stretch">
                        <Button Style="{StaticResource TitleBarButton}" 
                                Width="40" 
                                Background="Transparent"
                                Click="MinimizeButton_OnClick">
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       FontSize="8"
                                       Text="&#xE921;" 
                                       Foreground="#FFF2F2F2"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Button>
                        
                        <Button Style="{StaticResource TitleBarButton}" 
                                Width="40" 
                                Background="Transparent"
                                Click="MaximizeRestoreButton_OnClick">
                            <TextBlock x:Name="MaximizeRestoreIcon"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="8"
                                       Text="&#xE922;" 
                                       Foreground="#FFF2F2F2"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Button>
                        
                        <Button Style="{StaticResource CloseButton}" 
                                Width="40" 
                                Background="Transparent"
                                Click="CloseButton_OnClick">
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       FontSize="8"
                                       Text="&#xE8BB;" 
                                       Foreground="#FFF2F2F2"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            
            <Border Grid.Row="1"
                    Grid.Column="0"
                    Background="#A0111111"
                    Height="50"
                    Margin="12"
                    CornerRadius="8"
                    Padding="8"
                    BorderThickness="1"
                    BorderBrush="#E0454545">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Border x:Name="ScanProgressBar"
                                     IsHitTestVisible="False"
                                     Background="#8032CD6A"
                                     VerticalAlignment="Stretch"
                                     HorizontalAlignment="Left"
                                     CornerRadius="7"/>
                        
                        <ui:DropDownButton x:Name="DriveDropDownButton"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch"
                                           BorderThickness="1"
                                           BorderBrush="#E0454545"
                                           HorizontalContentAlignment="Stretch"
                                           VerticalContentAlignment="Center"
                                           CornerRadius="6">
                            <ui:DropDownButton.Flyout>
                                <ContextMenu x:Name="DriveMenu" />
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>
                    </Grid>
                    
                    <ui:Button x:Name="ScanButton"
                            Grid.Column="1"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            Margin="8,0,0,0"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="#E0454545"
                            PressedBackground="#08FFFFFF"
                            PressedBorderBrush="#E0454545"
                            MouseOverBorderBrush="#E0454545"
                            MouseOverBackground="#15FFFFFF"
                            Click="ScanButton_OnClick">
                        <TextBlock VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Text="Scan"
                                   FontSize="12"
                                   Foreground="#FFF2F2F2"/> <!-- Had to set this because I want the text to stay white when button is pressed. -->
                    </ui:Button>
                </Grid>
            </Border>
            
            <Border Grid.Row="1" 
                    Grid.Column="1"
                    Background="#A0111111"
                    Height="50"
                    Margin="0,0,12,0"
                    CornerRadius="8"
                    Padding="14,8,8,8"
                    BorderThickness="1"
                    BorderBrush="#E0454545">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               FontSize="10"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontWeight="Light"
                               Text="Selected Drive:"/>
                    
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               FontSize="10"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontWeight="Light"
                               Text="Total Space:"/>
                    
                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               FontSize="10"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontWeight="Light"
                               Text="Used Space:"/>
                    
                    <TextBlock Grid.Row="0"
                               Grid.Column="3"
                               FontSize="10"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontWeight="Light"
                               Text="Free Space:"/>
                    
                    <TextBlock Grid.Row="1"
                               x:Name="SelectedDriveTextBlock"
                               Grid.Column="0"
                               FontSize="10"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontWeight="Bold"/>
                    
                    <TextBlock Grid.Row="1"
                               x:Name="TotalSpaceTextBlock"
                               Grid.Column="1"
                               FontSize="10"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontWeight="Bold"/>
                    
                    <TextBlock Grid.Row="1"
                               x:Name="UsedSpaceTextBlock"
                               Grid.Column="2"
                               FontSize="10"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontWeight="Bold"/>
                    
                    <TextBlock Grid.Row="1"
                               x:Name="FreeSpaceTextBlock"
                               Grid.Column="3"
                               FontSize="10"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontWeight="Bold"/>
                </Grid>
            </Border>
            
            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="2*" MinWidth="250"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0"
                        Background="#A0111111"
                        Margin="12,0,12,12"
                        CornerRadius="8"
                        Padding="8,0,8,0"
                        BorderThickness="1"
                        BorderBrush="#E0454545">
                    <!-- Had to remove layout rounding because I found that it caused extra width which triggers the CancelResize() of WPF. -->
                    <Grid x:Name="ExplorerColumnsGrid"
                          UseLayoutRounding="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="80"/>
                            <ColumnDefinition Width="1*" MinWidth="90"/>
                            <ColumnDefinition Width="1*" MinWidth="100"/>
                            <ColumnDefinition Width="1*" MinWidth="90"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Row="0" Grid.Column="0" Margin="6,0,6,0"
                                Style="{StaticResource ExplorerSortHeader}" Tag="Name"
                                Click="ExplorerSortHeader_OnClick" AutomationProperties.Name="Sort by Name">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Name"/>
                                <TextBlock x:Name="NameSortArrow" FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="0" Grid.Column="1" Margin="12,0,6,0"
                                Style="{StaticResource ExplorerSortHeader}" Tag="Size"
                                Click="ExplorerSortHeader_OnClick" AutomationProperties.Name="Sort by Size">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Size"/>
                                <TextBlock x:Name="SizeSortArrow" Text="▼" FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="0" Grid.Column="2" Margin="12,0,6,0"
                                Style="{StaticResource ExplorerSortHeader}" Tag="OccupiedPercentage"
                                Click="ExplorerSortHeader_OnClick" AutomationProperties.Name="Sort by Percent Occupied">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="% Occupied"/>
                                <TextBlock x:Name="OccupiedSortArrow" FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="0" Grid.Column="3" Margin="12,0,0,0"
                                Style="{StaticResource ExplorerSortHeader}" Tag="Extension"
                                Click="ExplorerSortHeader_OnClick" AutomationProperties.Name="Sort by Extension">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Extension"/>
                                <TextBlock x:Name="ExtensionSortArrow" FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <Border Grid.Row="1"
                                Grid.ColumnSpan="4"
                                Grid.Column="0"
                                Height="1"
                                Background="#E0454545"/>
                        
                        <TreeView x:Name="ExplorerResultsTree"
                                  Grid.Row="2"
                                  Grid.ColumnSpan="4"
                                  Grid.Column="0"
                                  Visibility="Collapsed"
                                  Background="Transparent"
                                  Foreground="#FFF2F2F2"
                                  FontSize="12"
                                  BorderThickness="0"
                                  Padding="0"
                                  Tag="{Binding ElementName=ExplorerColumnsGrid}"
                                  SelectedItemChanged="ExplorerResultsTree_OnSelectedItemChanged"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <TreeView.Resources>
                                <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TreeViewItem">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        
                                                        <Border x:Name="RowBG">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                                    <Setter Property="BorderThickness" Value="0"/>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#334D4D4D"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <ContentPresenter ContentSource="Header"/>
                                                        </Border>

                                                        <Border x:Name="SelectionOutline"
                                                                Grid.Row="0"
                                                                BorderBrush="#E0454545"
                                                                BorderThickness="1"
                                                                IsHitTestVisible="False"
                                                                Visibility="Collapsed"/>
                                                        
                                                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1"/>
                                                    </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsExpanded" Value="False">
                                                        <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="RowBG" Property="Background" Value="#334D4D4D"/>
                                                        <Setter TargetName="SelectionOutline" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TreeView.Resources>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <Grid Height="28"
                                          Width="{Binding Tag.ActualWidth, RelativeSource={RelativeSource AncestorType=TreeView}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding Tag.ColumnDefinitions[0].Width, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                                              MinWidth="{Binding Tag.ColumnDefinitions[0].MinWidth, RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                            <ColumnDefinition Width="{Binding Tag.ColumnDefinitions[1].Width, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                                              MinWidth="{Binding Tag.ColumnDefinitions[1].MinWidth, RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                            <ColumnDefinition Width="{Binding Tag.ColumnDefinitions[2].Width, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                                              MinWidth="{Binding Tag.ColumnDefinitions[2].MinWidth, RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                            <ColumnDefinition Width="{Binding Tag.ColumnDefinitions[3].Width, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                                              MinWidth="{Binding Tag.ColumnDefinitions[3].MinWidth, RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Margin="{Binding NameIndent}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton Width="16"
                                                          Background="Transparent"
                                                          BorderThickness="0"
                                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Mode=TwoWay}"
                                                          Visibility="{Binding HasChildren, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <TextBlock x:Name="Chevron"
                                                                   FontFamily="Segoe Fluent Icons"
                                                                   FontSize="10"
                                                                   Foreground="#FFF2F2F2"
                                                                   Text="&#xE76C;"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            <TextBlock Grid.Column="1"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="16"
                                                       Foreground="#FFF2F2F2"
                                                       Text="&#xE8B7;"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsDirectory, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <TextBlock Grid.Column="1"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="16"
                                                       Foreground="#FFF2F2F2"
                                                       Text="&#xE729;"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Name}"
                                                       Foreground="#FFF2F2F2"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Size}" Foreground="#FFF2F2F2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding OccupiedPercentage}" Foreground="{Binding OccupiedPercentageForeground}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Extension}" Foreground="#FFF2F2F2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <TextBlock x:Name="ExplorerPlaceholder"
                                   Grid.Row="2"
                                   Grid.Column="0"
                                   FontSize="10"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="Light"
                                   Text="Scan a drive or folder to view its contents."
                                   Typography.NumeralAlignment="Tabular"/> <!-- Tabular alignment gives evert number the same width and prevents twitching when the file count changes. -->
                        
                        <GridSplitter Grid.RowSpan="3"
                                      Grid.Column="0"
                                      Style="{StaticResource ExplorerColumnDivider}"
                                      AutomationProperties.Name="Resize Name and Size columns"/>
                        <GridSplitter Grid.RowSpan="3"
                                      Grid.Column="1"
                                      Style="{StaticResource ExplorerColumnDivider}"
                                      AutomationProperties.Name="Resize Size and Percent Occupied columns"/>
                        <GridSplitter Grid.RowSpan="3"
                                      Grid.Column="2"
                                      Style="{StaticResource ExplorerColumnDivider}"
                                      AutomationProperties.Name="Resize Percent Occupied and Extension columns"/>
                    </Grid>
                </Border>
                
                <Border Grid.Column="1"
                        Background="#A0111111"
                        Margin="0,0,12,12"
                        CornerRadius="8"
                        Padding="8,0,8,8"
                        BorderThickness="1"
                        BorderBrush="#E0454545">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="#FFF2F2F2"
                                   Text="Properties"
                                   Margin="6,0,0,0"/>
                        
                        <Border Grid.Row="1"
                                Height="1"
                                Background="#E0454545"/>
                        
                        <Grid Grid.Row="2">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source, ElementName=SelectedEntryIcon}"
                                                     Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Image x:Name="SelectedEntryIcon"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   Width="32"
                                   Height="32"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="4,12,8,12"/>
                            
                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Foreground="#FFF2F2F2"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Text="{Binding SelectedItem.Name, ElementName=ExplorerResultsTree}"
                                       Margin="10,0,4,0"
                                       FontSize="12"/>
                            
                            <Border Grid.ColumnSpan="2"
                                    Grid.Column="0"
                                    Grid.Row="1"
                                    Height="1"
                                    Background="#A0454545"
                                    Margin="-8,0,-8,0"/>
                            
                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Kind:"
                                       FontSize="12"
                                       Margin="6,12,4,12"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="SelectedEntryKind"
                                       Grid.Row="2"
                                       Grid.Column="1"
                                       FontSize="12"
                                       FontWeight="Light"
                                       Margin="10,12,4,12"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Text="Size:"
                                       FontSize="12"
                                       Margin="6,12,4,12"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="SelectedEntrySize"
                                       Grid.Row="3"
                                       Grid.Column="1"
                                       FontSize="12"
                                       FontWeight="Light"
                                       Margin="10,12,4,12"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       Text="Where:"
                                       FontSize="12"
                                       Margin="6,12,4,12"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"/>
                            
                            <TextBox x:Name="SelectedEntryFullPath"
                                     Grid.Row="4"
                                     Grid.Column="1"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="#FFF2F2F2"
                                     FontSize="12"
                                     FontWeight="Light"
                                     Margin="0,7,4,6"
                                     Padding= "7,5,2,6"
                                     VerticalContentAlignment="Center"
                                     TextWrapping="NoWrap"
                                     PreviewMouseLeftButtonUp="SelectedEntryFullPath_OnPreviewMouseLeftButtonUp"/>

                            <TextBlock Grid.Row="5"
                                       Grid.Column="0"
                                       Text="Created:"
                                       FontSize="12"
                                       Margin="6,12,4,12"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="SelectedEntryCreated"
                                       Grid.Row="5"
                                       Grid.Column="1"
                                       FontSize="12"
                                       FontWeight="Light"
                                       Margin="10,12,4,12"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="6"
                                       Grid.Column="0"
                                       Text="Modified:"
                                       FontSize="12"
                                       Margin="6,12,4,12"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="SelectedEntryModified"
                                       Grid.Row="6"
                                       Grid.Column="1"
                                       FontSize="12"
                                       FontWeight="Light"
                                       Margin="10,12,4,12"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>

                            <Grid Grid.Row="8"
                                  Grid.ColumnSpan="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>

                                <ui:Button x:Name="DeleteSelectedEntryButton"
                                           Click="DeleteSelectedEntryButton_OnClick"
                                           MinWidth="70"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch"
                                           CornerRadius="6"
                                           BorderThickness="1"
                                           BorderBrush="#E0454545"
                                           PressedBackground="#08FFFFFF"
                                           PressedBorderBrush="#E0454545"
                                           MouseOverBorderBrush="#E0454545"
                                           MouseOverBackground="#15FFFFFF"
                                           Height="32">
                                    <TextBlock Text="Delete"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="#FFF2F2F2"/>
                                </ui:Button>

                                <ui:Button x:Name="ShowInExplorerButton"
                                           Grid.Column="1"
                                           Margin="8,0,0,0"
                                           Click="ShowInExplorerButton_OnClick"
                                           MinWidth="130"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch"
                                           CornerRadius="6"
                                           BorderThickness="1"
                                           BorderBrush="#E0454545"
                                           PressedBackground="#08FFFFFF"
                                           PressedBorderBrush="#E0454545"
                                           MouseOverBorderBrush="#E0454545"
                                           MouseOverBackground="#15FFFFFF"
                                           Height="32">
                                    <TextBlock Text="Show in Explorer"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="#FFF2F2F2"/>
                                </ui:Button>
                            </Grid>

                            <Popup x:Name="CopyFullPathPopup"
                                   PlacementTarget="{Binding ElementName=SelectedEntryFullPath}"
                                   Placement="Top"
                                   VerticalOffset="-4"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border Background="#FF2A2A2A"
                                        BorderBrush="#E0454545"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="2">
                                    <Button Background="Transparent"
                                            BorderThickness="0"
                                            Padding="7,4"
                                            ToolTip="Copy full path"
                                            Click="CopyFullPathButton_OnClick">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe Fluent Icons"
                                                       FontSize="13"
                                                       Text="&#xE8C8;"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0"
                                                       Text="Copy"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>
