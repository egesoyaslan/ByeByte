<!-- TO DO: Add dropdown menu to title in title bar that has an about section -->

<ui:FluentWindow x:Class="ByteFinder.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 FontFamily="Segoe UI"
                 FontSize="14"
                 Title="ByeByte"
                 Width="1100"
                 Height="720"
                 MinWidth="850"
                 MinHeight="550"
                 WindowStartupLocation="CenterScreen"
                 Background="Transparent"
                 WindowBackdropType="Acrylic"
                 ExtendsContentIntoTitleBar="True"
                 StateChanged="Window_OnStateChanged"
                 Foreground="#FFF2F2F2">
    <Window.Resources>
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="#B3E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Border Background="#80000000">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Background="#FF111111"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="ByeByte" 
                               Margin="16,0"
                               VerticalAlignment="Center"/>
                    
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Stretch">
                        <Button Style="{StaticResource TitleBarButton}" 
                                Width="40" 
                                Background="Transparent"
                                Click="MinimizeButton_OnClick">
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       FontSize="8"
                                       Text="&#xE921;" 
                                       Foreground="#FFF2F2F2"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Button>
                        
                        <Button Style="{StaticResource TitleBarButton}" 
                                Width="40" 
                                Background="Transparent"
                                Click="MaximizeRestoreButton_OnClick">
                            <TextBlock x:Name="MaximizeRestoreIcon"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="8"
                                       Text="&#xE922;" 
                                       Foreground="#FFF2F2F2"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Button>
                        
                        <Button Style="{StaticResource CloseButton}" 
                                Width="40" 
                                Background="Transparent"
                                Click="CloseButton_OnClick">
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       FontSize="8"
                                       Text="&#xE8BB;" 
                                       Foreground="#FFF2F2F2"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            
            <Border Grid.Row="1"
                    Grid.Column="0"
                    Background="#FF111111"
                    Height="50"
                    Margin="12"
                    CornerRadius="8"
                    Padding="8"
                    BorderThickness="1"
                    BorderBrush="#FF3A3A3A">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    
                    <ui:DropDownButton x:Name="DriveDropDownButton"
                                       Grid.Column="0"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       BorderThickness="1"
                                       BorderBrush="#FF3A3A3A"
                                       HorizontalContentAlignment="Stretch"
                                       VerticalContentAlignment="Center">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu x:Name="DriveMenu" />
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                    <ui:Button Grid.Column="1"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            Margin="8,0,0,0"
                            CornerRadius="4"
                            BorderThickness="1"
                            BorderBrush="#FF3A3A3A"
                            PressedBackground="#08FFFFFF"
                            PressedBorderBrush="#FF3A3A3A"
                            MouseOverBorderBrush="#FF3A3A3A"
                            MouseOverBackground="#15FFFFFF">
                        <TextBlock VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Text="Scan"
                                   FontSize="12"
                                   Foreground="#FFF2F2F2"/> <!-- Had to set this because I want the text to stay white when button is pressed. -->
                    </ui:Button>
                </Grid>
            </Border>
            
            <Border Grid.Row="1" 
                    Grid.Column="1"
                    Background="#FF111111"
                    Height="50"
                    Margin="0,0,12,0"
                    CornerRadius="8"
                    Padding="14,8,8,8"
                    BorderThickness="1"
                    BorderBrush="#FF3A3A3A">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               FontSize="10"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontWeight="Light"
                               Text="Selected Drive:"/>
                    
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               FontSize="10"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontWeight="Light"
                               Text="Total Space:"/>
                    
                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               FontSize="10"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontWeight="Light"
                               Text="Used Space:"/>
                    
                    <TextBlock Grid.Row="0"
                               Grid.Column="3"
                               FontSize="10"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontWeight="Light"
                               Text="Free Space:"/>
                    
                    <TextBlock Grid.Row="1"
                               x:Name="SelectedDriveTextBlock"
                               Grid.Column="0"
                               FontSize="10"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontWeight="Bold"/>
                    
                    <TextBlock Grid.Row="1"
                               x:Name="TotalSpaceTextBlock"
                               Grid.Column="1"
                               FontSize="10"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontWeight="Bold"/>
                    
                    <TextBlock Grid.Row="1"
                               x:Name="UsedSpaceTextBlock"
                               Grid.Column="2"
                               FontSize="10"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontWeight="Bold"/>
                    
                    <TextBlock Grid.Row="1"
                               x:Name="FreeSpaceTextBlock"
                               Grid.Column="3"
                               FontSize="10"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontWeight="Bold"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
