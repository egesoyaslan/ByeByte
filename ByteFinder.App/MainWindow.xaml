<ui:FluentWindow x:Class="ByteFinder.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 FontFamily="Segoe UI"
                 FontSize="14"
                 Title="ByeByte"
                 Width="1100"
                 Height="720"
                 MinWidth="850"
                 MinHeight="550"
                 WindowStartupLocation="CenterScreen"
                 Background="Transparent"
                 WindowBackdropType="Acrylic"
                 ExtendsContentIntoTitleBar="True"
                 StateChanged="Window_OnStateChanged"
                 Foreground="#FFF2F2F2">
    <Window.Resources>
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="#B3E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Border Background="#80000000">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Background="#FF111111"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="ByeByte" 
                               Foreground="White" 
                               Margin="16,0"
                               VerticalAlignment="Center"/>
                    
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Stretch">
                        <Button Style="{StaticResource TitleBarButton}" 
                                Width="40" 
                                Background="Transparent"
                                Click="MinimizeButton_OnClick">
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       FontSize="8"
                                       Text="&#xE921;" 
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Button>
                        
                        <Button Style="{StaticResource TitleBarButton}" 
                                Width="40" 
                                Background="Transparent"
                                Click="MaximizeRestoreButton_OnClick">
                            <TextBlock x:Name="MaximizeRestoreIcon"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="8"
                                       Text="&#xE922;" 
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Button>
                        
                        <Button Style="{StaticResource CloseButton}" 
                                Width="40" 
                                Background="Transparent"
                                Click="CloseButton_OnClick">
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       FontSize="8"
                                       Text="&#xE8BB;" 
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            
            <Border Grid.Row="1"
                    Grid.Column="0"
                    Background="#FF111111"
                    Height="45"
                    Margin="12"
                    CornerRadius="8"
                    Padding="8"
                    BorderThickness="1"
                    BorderBrush="#FF3A3A3A">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    
                    <ui:DropDownButton Grid.Column="0"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       BorderThickness="1"
                                       BorderBrush="#FF3A3A3A">
                        
                    </ui:DropDownButton>
                    <ui:Button Grid.Column="1"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            Margin="8,0,0,0"
                            CornerRadius="4"
                            BorderThickness="1"
                            BorderBrush="#FF3A3A3A">
                        <TextBlock VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Text="Scan"
                                   FontSize="12"/>
                    </ui:Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
